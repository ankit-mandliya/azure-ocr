APP_NAME=ContactHub
APP_ENV=development
JSON_STORAGE_PATH=data/contacts.json
# Optional database connection (e.g. mssql+pyodbc://... or sqlite:///data/contacts.db)
# DATABASE_URL=
MAX_UPLOAD_MB=10
OCR_DEVICE=cpu
OCR_DEFAULT_PROFILE=latin
OCR_ENABLE_PREPROCESSING=true
CORS_ORIGINS=["http://localhost:5173"]
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# CPU execution optimization on Windows (avoids PaddlePaddle PIR oneDNN conversion bug)
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
FLAGS_use_mkldnn=0
FLAGS_enable_pir_api=0
